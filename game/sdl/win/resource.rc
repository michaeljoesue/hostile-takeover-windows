#include <winver.h>

1 24 "app.manifest"
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,6,0,0
PRODUCTVERSION  1,6,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Spiffcode, Inc. (open source port)"
      VALUE "FileDescription",  "Hostile Takeover"
      VALUE "FileVersion",      "1.6"
      VALUE "InternalName",     "HostileTakeover"
      VALUE "LegalCopyright",   "Copyright (c) 2004-2014 Spiffcode, Inc. BSD license."
      VALUE "OriginalFilename", "HostileTakeover.exe"
      VALUE "ProductName",      "Hostile Takeover"
      VALUE "ProductVersion",   "1.6"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
